{
  "name": "career-media",
  "version": "0.1.0",
  "private": true,
  "description": "未経験転職オウンドメディアMVP（提案用・非公開）",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "pipeline": "tsx pipeline/src/cli.ts",
    "content:check": "tsx pipeline/src/cli.ts check",
    "db:seed-sql": "tsx pipeline/src/cli.ts seed-sql",
    "db:verify": "bash scripts/verify-db.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "motifs": "tsx scripts/gen-motifs.ts",
    "export:static": "tsx scripts/export-static.ts",
    "local": "bash scripts/start-local.sh",
    "demo": "node scripts/demo.mjs neutral",
    "sales:docs": "tsx scripts/gen-sales-docs.ts",
    "check:outbound": "tsx scripts/check-outbound.ts",
    "sns:images": "node scripts/sns-images.mjs",
    "demo:makecareer": "node scripts/demo.mjs makecareer",
    "image:generate": "tsx scripts/images/cli.ts generate",
    "image:dry-run": "tsx scripts/images/cli.ts generate --dry-run",
    "image:status": "tsx scripts/images/cli.ts status",
    "image:index": "tsx scripts/images/cli.ts index",
    "image:validate": "tsx scripts/images/cli.ts validate",
    "image:prune": "tsx scripts/images/cli.ts prune"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
