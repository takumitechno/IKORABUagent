# =============================================================================
# 未経験転職メディアMVP — 環境変数テンプレート
#   cp .env.example .env.local
# .env.local は .gitignore 済み。絶対に commit しない。
# =============================================================================

# --- サイト ---------------------------------------------------------------
# canonical / OGP / sitemap の基準URL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 検索エンジンへのindex許可。正式な提携・ブランド利用許諾までは false のまま。
# false の間は robots.txt が全Disallow、全ページに noindex が付く。
SITE_INDEXABLE=false

# --- コンテンツの読み込み元 -------------------------------------------------
# local    : content/*.md を読む（既定・セットアップ不要）
# supabase : Supabase の articles テーブルを anon key + RLS で読む
CONTENT_SOURCE=local

# --- Supabase (CONTENT_SOURCE=supabase のとき) -----------------------------
# ブラウザに出してよいのは URL と anon key だけ。RLSで published のみ読める。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 相談導線 ---------------------------------------------------------------
# 相談先URL・計測IDは src/config/partner.ts が正本。
# 計測用LPなどへ一時的に差し替えたい場合のみ上書きする。
# PARTNER_CONSULTATION_URL=
# PARTNER_CAMPAIGN_ID=

# =============================================================================
# 以下は記事パイプライン(pipeline/)専用。Next.js からは読まない。
# service role key は RLS をバイパスするため、フロントのコード・
# NEXT_PUBLIC_* 変数・ブラウザには絶対に渡さない。
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# JINA_API_KEY=
# DISCORD_WEBHOOK_URL=
