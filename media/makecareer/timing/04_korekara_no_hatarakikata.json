  "subtitles": [
    {
      "id": "p1a",
      "start": 0.36,
      "end": 2.84,
      "text": "入社3年目。\n仕事には慣れた。"
    },
    {
      "id": "p1b",
      "start": 2.86,
      "end": 5.17,
      "text": "でも、来年も\n同じ毎日が見える。"
    },
    {
      "id": "p2a",
      "start": 5.38,
      "end": 6.83,
      "text": "辞めたいほど嫌じゃない。"
    },
    {
      "id": "p2b",
      "start": 6.85,
      "end": 9.18,
      "text": "だからこそ、\n動く理由も見つからない。"
    },
    {
      "id": "p3a",
      "start": 9.39,
      "end": 11.87,
      "text": "まず考えたいのは、\n辞めるかどうかより、"
    },
    {
      "id": "p3b",
      "start": 11.89,
      "end": 14.23,
      "text": "この先どんな仕事や\n働き方をしたいか。"
    },
    {
      "id": "p4a",
      "start": 14.44,
      "end": 17.34,
      "text": "メイクキャリアでは、\n今の経験や希望を聞きながら、"
    },
    {
      "id": "p4b",
      "start": 17.36,
      "end": 19.67,
      "text": "長い目で見たキャリアを\n一緒に考えます。"
    },
    {
      "id": "p5a",
      "start": 19.88,
      "end": 22.57,
      "text": "「このままでいいのかな」を、\n具体的な相談に。"
    },
    {
      "id": "p5b",
      "start": 22.59,
      "end": 26.67,
      "text": "プロフィールのリンクから、\n無料面談へ。"
    }
  ],
  "telops": [
    {
      "id": "hook",
      "start": 0.0,
      "end": 5.12,
      "text": "仕事には慣れた。\nでも、{この先は？}"
    },
    {
      "id": "s2",
      "start": 5.32,
