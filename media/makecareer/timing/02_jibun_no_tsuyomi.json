    {
      "id": "p3b",
      "start": 12.59,
      "end": 14.84,
      "text": "「その中で、どう動いたか」も\n話してみて。"
    },
    {
      "id": "p4a",
      "start": 15.17,
      "end": 17.28,
      "text": "メイクキャリアでは、\n経験を振り返り、"
    },
    {
      "id": "p4b",
      "start": 17.3,
      "end": 20.21,
      "text": "応募先に伝えるアピールポイントを\n一緒に考えます。"
    },
    {
      "id": "p5a",
      "start": 20.43,
      "end": 22.5,
      "text": "自分の経験を、\nどう伝えればいいか。"
    },
    {
      "id": "p5b",
      "start": 22.52,
      "end": 27.42,
      "text": "プロフィールのリンクから、\n無料面談で相談してみませんか。"
    }
