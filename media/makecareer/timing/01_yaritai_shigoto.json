    {
      "id": "p1a",
      "start": 0.36,
      "end": 1.69,
      "text": "接客を辞めたい。"
    },
    {
      "id": "p1b",
      "start": 1.71,
      "end": 4.2,
      "text": "でも、次に\nやりたい仕事はない。"
    },
    {
      "id": "p1c",
      "start": 4.22,
      "end": 6.74,
      "text": "求人を見ても、\n保存するだけで終わってない？"
    },
    {
      "id": "p2a",
      "start": 7.16,
      "end": 9.27,
      "text": "変えたいのは、\n不規則な休み？"
    },
    {
      "id": "p2b",
      "start": 9.29,
      "end": 11.62,
      "text": "それとも、\n人と話す仕事そのもの？"
    },
    {
      "id": "p3a",
      "start": 11.83,
      "end": 13.86,
      "text": "「何になりたいか」が\n決まっていなくても、"
    },
    {
      "id": "p3b",
      "start": 13.88,
      "end": 16.27,
      "text": "「今の何を変えたいか」から\n話してみよう。"
    },
    {
      "id": "p4a",
      "start": 16.61,
      "end": 20.01,
      "text": "メイクキャリアは、\n20代の未経験転職をサポート。"
    },
    {
      "id": "p4b",
      "start": 20.03,
      "end": 23.28,
      "text": "これまでの仕事と希望をもとに、\n求人選びを相談できます。"
    },
    {
      "id": "p5a",
      "start": 23.49,
      "end": 25.42,
      "text": "次の仕事を\n一緒に考えたい方は、"
    },
    {
      "id": "p5b",
      "start": 25.44,
      "end": 29.29,
      "text": "プロフィールのリンクから\n無料相談へ。"
    }
  ],
