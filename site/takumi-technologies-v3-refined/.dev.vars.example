# Copy to .dev.vars for `wrangler pages dev` (never commit .dev.vars).
# In production, set these in Cloudflare: Pages project → Settings → Variables and Secrets.
# The recipient (info@takumitechno.com) is fixed in functions/api/contact.js and is not configurable here.
SMTP2GO_API_KEY=replace-with-secret
# optional: a different sender verified in SMTP2GO (default info@takumitechno.com)
# CONTACT_FROM=info@takumitechno.com
# optional: Turnstile secret; when set, the page also needs data-turnstile-sitekey
# TURNSTILE_SECRET_KEY=replace-with-secret
