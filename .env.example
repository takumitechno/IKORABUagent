# Discord 通知（共通）。未設定なら通知はスキップ（処理は継続）
DISCORD_WEBHOOK_URL=
# Supabase MCP を使う場合（任意）
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_KEY=
# LLM / 外部 API（仮説生成・検証で使う場合）
GEMINI_API_KEY=
XAI_API_KEY=
JINA_API_KEY=

# Threads production Capability Bridge (localhost development default)
THREADS_BRIDGE_URL=http://127.0.0.1:8000
THREADS_BRIDGE_API_KEY=
# Default read-only account (no credential or database path).
THREADS_DASHBOARD_ACCOUNT_ID=acct_8ssana

# Dashboard origin. Keep the host on loopback when Cloudflare Tunnel is used;
# cloudflared connects to this private origin and the Bridge is never exposed.
POKEMON_AGENTS_HOST=127.0.0.1
POKEMON_AGENTS_PORT=5733
# local: normal localhost development
# cloudflare-access: /internal requires Cloudflare Access' authenticated-user header
DASHBOARD_INTERNAL_AUTH=local
# Required in cloudflare-access mode. Comma-separated, lower/upper case ignored.
DASHBOARD_INTERNAL_ALLOWED_EMAILS=
# Required in cloudflare-access mode. Only these Threads accounts appear in HQ.
DASHBOARD_INTERNAL_ACCOUNT_IDS=
# Required in cloudflare-access mode; generate at least 32 random characters.
DASHBOARD_CSRF_SECRET=
# Optional service identity for hooks/automation in external mode (32+ chars).
DASHBOARD_INTERNAL_API_KEY=
# Data Plane Bridge auth mode: local (loopback only) or api-key (key required).
AUTOPILOT_BRIDGE_AUTH_MODE=local
AUTOPILOT_BRIDGE_API_KEY=
# Tenant enforcement remains off until canary authorization. Shadow flags
# evaluate would-allow/would-deny without changing responses or access.
FEATURE_MULTI_TENANT_AUTH=false
FEATURE_MULTI_TENANT_AUTH_SHADOW=false
DASHBOARD_MULTI_TENANT_AUTH=false
DASHBOARD_MULTI_TENANT_AUTH_SHADOW=false
DASHBOARD_MULTI_TENANT_AUTH_CANARY=false
DASHBOARD_MULTI_TENANT_AUTH_CANARY_USER_ID=
DASHBOARD_MULTI_TENANT_AUTH_CANARY_ACCOUNT_ID=
# Data Plane only: caller cannot override these through the capability client.
# PRODUCTION_WRITER_PROVIDER=anthropic
# Optional when starting the Data Plane Bridge. If unset, the Data Plane uses
# its project-root data/research.db; any explicit value must be absolute.
# THREADS_PRODUCTION_DB=C:\absolute\path\to\data\research.db
