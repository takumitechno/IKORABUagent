{
  "project": "ikolabu-agent-os",
  "description": "=LOVE Agent OS Control Plane のローカルスケジュール",
  "naming_convention": "com.ikolabu.agentos.{task}",
  "updated_at": "2026-09-18",
  "jobs": [
    {
      "label": "com.ikolabu.agentos.dashboard",
      "agent": "agent-os-dashboard",
      "description": "Control Plane dashboard（常駐、ポート5733）",
      "schedule": "常駐（KeepAlive）",
      "model": "N/A",
      "agent_md": "N/A",
      "runner": "bun pokemon-agents/web/server.ts",
      "log": "~/.claude/logs/ikolabu-agent-os-dashboard.log",
      "dashboard": "http://localhost:5733/"
    },
    {
      "label": "com.ikolabu.agentos.sashihara-orchestrator",
      "agent": "sashihara-orchestrator",
      "description": "通常運用を衣織→舞香→瞳の順で委譲する総監督",
      "schedule": "毎日 2:00",
      "model": "opus",
      "agent_md": ".claude/agents/sashihara-orchestrator.md",
      "log": "~/.claude/logs/ikolabu-sashihara-orchestrator.log",
      "subagents": [
        { "name": "iori-validator", "role": "Evidence検証", "agent_md": ".claude/agents/iori-validator.md", "model": "sonnet" },
        { "name": "maika-hypothesizer", "role": "仮説・分析", "agent_md": ".claude/agents/maika-hypothesizer.md", "model": "opus" },
        { "name": "hitomi-selector", "role": "戦略選定", "agent_md": ".claude/agents/hitomi-selector.md", "model": "sonnet" }
      ]
    },
    {
      "label": "com.ikolabu.agentos.anna-supervisor",
      "agent": "anna-supervisor",
      "description": "Control Planeを監査し、承認済み改善だけを樹愛羅へ委譲",
      "schedule": "毎日 5:00",
      "model": "opus",
      "agent_md": ".claude/agents/anna-supervisor.md",
      "log": "~/.claude/logs/ikolabu-anna-supervisor.log",
      "subagents": [
        { "name": "kiara-executor", "role": "承認済み改善の適用・テスト・revert", "agent_md": ".claude/agents/kiara-executor.md", "model": "sonnet" }
      ]
    },
    {
      "label": "com.ikolabu.agentos.sanatsun-knowledge-editor",
      "agent": "sanatsun-knowledge-editor",
      "description": "ドメイン知識・編集基準・ブランド規則の週次保守",
      "schedule": "毎週月曜 3:00",
      "model": "sonnet",
      "agent_md": ".claude/agents/sanatsun-knowledge-editor.md",
      "log": "~/.claude/logs/ikolabu-sanatsun-knowledge-editor.log"
    }
  ]
}
